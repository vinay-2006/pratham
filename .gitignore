# =============================================================================
# PRATHAM — .gitignore (Python + Node + General)
# =============================================================================

# ── Environment ───────────────────────────────────────────────────────────────
.env
.env.local
.env.*.local

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
*.pyo
*.pyd
.Python
env/
venv/
.venv/
ENV/
pip-log.txt
pip-delete-this-directory.txt
.tox/
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
*.log

# ── Node / Frontend ───────────────────────────────────────────────────────────
node_modules/
dist/
.next/
out/
.nuxt/
.cache/
.parcel-cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm
.yarn/

# ── ML Models ─────────────────────────────────────────────────────────────────
ml_models/*.pt
ml_models/*.bin
ml_models/*.onnx
data/*.csv
data/*.json
data/*.parquet

# ── IDE / OS ──────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ── Docker ────────────────────────────────────────────────────────────────────
.docker/
